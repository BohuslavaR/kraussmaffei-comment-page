# Shared editor settings, so every editor formats the files the same way.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Trailing spaces can mean a line break in Markdown.
[*.md]
trim_trailing_whitespace = false
